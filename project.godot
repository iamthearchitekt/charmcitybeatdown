config_version=5

[application]
config/name="CHARM CITY BEATDOWN"
run/main_scene="res://startup.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Midnight at the harbor. An original Baltimore arcade fighter."
config/icon="res://assets/game-icon.png"
config/windows_native_icon="res://assets/charm-city-beatdown.ico"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.02,0.035,0.07,1)

[audio]
default_bus_layout="res://default_bus_layout.tres"
